# X (Twitter) API — OAuth 2.0 user context
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Optional: OAuth 1.0a (alternative to OAuth 2.0 above)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN_OAUTH1=
# X_ACCESS_SECRET=

# LLM — set LLM_PROVIDER to anthropic or openai (only one is used)
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional overrides
# CONFIG_PATH=config/local.yaml
