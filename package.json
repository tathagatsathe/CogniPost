{
  "name": "cognipost",
  "version": "1.0.0",
  "description": "Automated daily AI fact tweets on X with reach optimization",
  "type": "module",
  "bin": {
    "cognipost": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "post": "node dist/cli.js post",
    "auth:x": "node dist/cli.js auth:x",
    "dry-run": "node dist/cli.js post --dry-run",
    "test:x-search": "node dist/scripts/test-x-search.js",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/optimize/rules.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "google-trends-api": "^4.9.2",
    "openai": "^4.77.0",
    "twitter-api-v2": "^1.20.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
